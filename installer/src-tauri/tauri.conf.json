{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "psd-ai-installer",
  "version": "1.0.0",
  "identifier": "ai.psd.installer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "psd.ai Installer",
        "label": "main",
        "width": 1060,
        "height": 740,
        "minWidth": 880,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
