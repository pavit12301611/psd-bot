{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "psd.ai",
  "version": "1.0.0",
  "identifier": "ai.psd.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "psd.ai",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "rpm",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Local-first AI assistant with offline models, voice and PC control",
    "longDescription": "psd.ai runs a group of local GGUF models through llama.cpp and gives an agent shell, a cookbook for serving models, memory, RAG, calendar and email tools, plus allow-listed desktop control on Wayland and X11. Nothing leaves the machine unless you configure a remote provider.",
    "homepage": "https://github.com/pavit12301611/psd-bot",
    "license": "MIT",
    "publisher": "psd.ai",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "rpm": {
        "release": "1",
        "epoch": 0,
        "depends": [
          "python3 >= 3.11",
          "tmux",
          "xdg-utils",
          "libnotify"
        ]
      },
      "deb": {
        "depends": [
          "python3",
          "tmux",
          "xdg-utils",
          "libnotify-bin"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      }
    }
  }
}
