# psd.ai engine as a systemd USER service (Fedora).
#
# A user unit, not a system one: psd.ai is a desktop app, and running it inside
# your session is what gives it access to the things it needs — the PipeWire
# microphone, the XDG Desktop Portal for screenshots, the GNOME/KDE keyring for
# secrets, and the Wayland socket for PC control. A system service would have to
# be granted each of those by hand and would still run as a different user than
# the one whose files it reads.
#
# Do not edit this file in place: install-service.sh copies it to
# ~/.config/systemd/user/psd_ai-ui.service and substitutes the placeholders
# below with the real paths for your checkout.
#
#   systemctl --user start psd_ai-ui        # start now
#   systemctl --user enable psd_ai-ui       # start on login
#   journalctl --user -u psd_ai-ui -f       # follow the log
#
# To keep it running after you log out (a headless box, or a server you SSH
# into), enable lingering once:
#   sudo loginctl enable-linger $USER

[Unit]
Description=psd.ai engine (web UI + agent)
Documentation=https://github.com/pavit12301611/psd-bot
# The model group is started separately by scripts/local_llama.py; the engine
# talks to it over HTTP and copes with it arriving later, so no ordering is
# forced here. Network is wanted because model downloads and web tools need it.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/venv/bin/python -m uvicorn app:app --host __HOST__ --port $APP_PORT
Restart=always
RestartSec=3

# The port the app binds has to be in the environment as well as on the command
# line: src/mcp_oauth.py, internal_api_base() and companion pairing all read
# APP_PORT to build callback URLs, and a callback aimed at the wrong port
# silently reaches nothing.
Environment=APP_PORT=__PORT__
Environment=PYTHONUNBUFFERED=1
# One BLAS thread per library. The engine does no large matrix work of its own —
# the local model server owns the CPU — and an import that wakes one thread per
# core steals them from llama.cpp.
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
EnvironmentFile=-__APP_DIR__/.env

# A model download or a long research run should not be killed for looking idle.
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

# Hardening that does not break desktop integration. ProtectHome has to stay
# off: the whole point of the agent is reading and writing your files, and the
# model cache lives in ~/.local/share/psd.ai/runtime.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
